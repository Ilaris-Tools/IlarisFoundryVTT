<section class="pre-effects-section">
    <h3>Pre-Effects</h3>
    <div class="pre-effects-list" data-section="preEffects">
        {{#each item.system.preEffects}}
        <fieldset class="pre-effect-card">
            <legend>Pre-Effect</legend>
            {{#if @root.isManeuverPreEffect}}
            <div class="form-group">
                <label>Auslöser:</label>
                <select name="system.preEffects.{{@index}}.activation">
                    <option value="onConfirmedHit" {{#if (ifEq activation "onConfirmedHit")}}selected{{/if}}>Bestätigter Treffer</option>
                    <option value="onSuccessfulDefense" {{#if (ifEq activation "onSuccessfulDefense")}}selected{{/if}}>Erfolgreiche Verteidigung</option>
                </select>
            </div>
            <div class="form-group">
                <label>Manöver-Operation:</label>
                <select name="system.preEffects.{{@index}}.operation">
                    <option value="">— Keine —</option>
                    <option value="deselectEquippedWeapon" {{#if (ifEq operation "deselectEquippedWeapon")}}selected{{/if}}>Ausgewählte Waffe abwählen</option>
                </select>
            </div>
            <div class="form-group">
                <label>Befreiungsprobe:</label>
                <select name="system.preEffects.{{@index}}.ilarisEnding.type">
                    <option value="">— Keine —</option>
                    <option value="opposedEscape" {{#if (ifEq ilarisEnding.type "opposedEscape")}}selected{{/if}}>GE oder KK</option>
                </select>
            </div>
            {{/if}}
            <button type="button" class="delete-pre-effect">✕</button>

            <div class="form-group">
                <label>Dauer (Runden):</label>
                <input type="number" name="system.preEffects.{{@index}}.baseDuration" value="{{baseDuration}}" data-dtype="Number" />
            </div>

            <div class="form-group">
                <label><input type="checkbox" name="system.preEffects.{{@index}}.condition.enabled" {{checked condition.enabled}} /> Zustand anwenden</label>
                <select name="system.preEffects.{{@index}}.condition.statusId">
                    <option value="">-- Zustand wÃ¤hlen --</option>
                    {{#each ../statusEffectOptions}}
                    <option value="{{id}}" {{#if (ifEq id ../condition.statusId)}}selected{{/if}}>{{name}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" name="system.preEffects.{{@index}}.instant" {{checked instant}} />
                    Sofort (kein Effekt, direkter Schaden)
                </label>
            </div>

            <div class="changes-list">
                <h4>Änderungen</h4>
                {{#if changes}}
                {{#each changes}}
                <fieldset class="change-card">
                    <legend>Änderung</legend>
                    <button type="button" class="delete-change">✕</button>

                    <div class="form-group">
                        <label>Key:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.changes.{{@index}}.key" value="{{key}}" />
                    </div>
                    <div class="form-group">
                        <label>Typ:</label>
                        <select name="system.preEffects.{{@../index}}.changes.{{@index}}.type">
                            <option value="add">add</option>
                            <option value="custom">custom (DOT)</option>
                            <option value="multiply">multiply</option>
                            <option value="override">override</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Wert:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.changes.{{@index}}.value" value="{{value}}" />
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="system.preEffects.{{@../index}}.changes.{{@index}}.amplifiedByMaechtigeMagie" {{checked amplifiedByMaechtigeMagie}} />
                            Verstärkt durch Mächtige Magie
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Mächtig Bonus:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.changes.{{@index}}.maechtigBonus" value="{{maechtigBonus}}" placeholder="z.B. +2W6" />
                    </div>
                    <div class="form-group">
                        <label>Schadenstyp:</label>
                        <select name="system.preEffects.{{@../index}}.changes.{{@index}}.damageType">
                            {{#each @root.damageTypeOptions}}
                            <option value="{{value}}" {{#if (ifEq value ../damageType)}}selected{{/if}}>{{label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Abgeschwächter Wert:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.changes.{{@index}}.diminishedValue" value="{{diminishedValue}}" placeholder="z.B. 1W6" />
                    </div>
                    <div class="form-group">
                        <label>Abgeschwächter MM Bonus:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.changes.{{@index}}.diminishedMaechtigBonus" value="{{diminishedMaechtigBonus}}" placeholder="z.B. +5" />
                    </div>
                    <div class="form-group">
                        <label>Priorität:</label>
                        <input type="number" name="system.preEffects.{{@../index}}.changes.{{@index}}.priority" value="{{priority}}" data-dtype="Number" />
                    </div>
                </fieldset>
                {{/each}}
                {{/if}}
                <button type="button" class="add-change">+ Änderung hinzufügen</button>
            </div>

            <div class="ilaris-modifiers-list">
                <h4>Ilaris-Modifikatoren</h4>
                {{#each ilarisModifiers}}
                <fieldset class="ilaris-modifier-card">
                    <legend>Ilaris-Modifikator</legend>
                    <button type="button" class="delete-ilaris-modifier">✕</button>
                    <div class="form-group">
                        <label>Phase:</label>
                        <select name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.phase">
                            {{selectOptions @root.ilarisModifierPhases selected=phase}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Ziel:</label>
                        <select name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.target">
                            {{selectOptions @root.ilarisModifierTargets selected=target}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Wert:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.value" value="{{value}}" placeholder="z. B. +2 oder +1W6" />
                    </div>
                    <div class="form-group">
                        <label>Stapelung:</label>
                        <select name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.stacking">
                            {{selectOptions @root.ilarisModifierStacking selected=stacking}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Vergleichswert:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.comparisonValue" value="{{comparisonValue}}" />
                    </div>
                    <div class="form-group">
                        <label>Fertigkeiten:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.selector.fertigkeit" value="{{selector.fertigkeit}}" placeholder="Kommagetrennt" />
                    </div>
                    <div class="form-group">
                        <label>Talente:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.selector.talent" value="{{selector.talent}}" placeholder="Kommagetrennt" />
                    </div>
                    <div class="form-group">
                        <label>Situation:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.selector.situation" value="{{selector.situation}}" placeholder="z. B. sozialesDuell" />
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.amplifiedByMaechtigeMagie" {{checked amplifiedByMaechtigeMagie}} /> Verstärkt durch Mächtige Magie</label>
                    </div>
                    <div class="form-group">
                        <label>Mächtig Bonus:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.maechtigBonus" value="{{maechtigBonus}}" placeholder="z. B. +2" />
                    </div>
                    <div class="form-group">
                        <label>Abgeschwächter Wert:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.diminishedValue" value="{{diminishedValue}}" />
                    </div>
                    <div class="form-group">
                        <label>Abgeschwächter Mächtig-Bonus:</label>
                        <input type="text" name="system.preEffects.{{@../index}}.ilarisModifiers.{{@index}}.diminishedMaechtigBonus" value="{{diminishedMaechtigBonus}}" />
                    </div>
                </fieldset>
                {{/each}}
                <button type="button" class="add-ilaris-modifier">+ Ilaris-Modifikator hinzufügen</button>
            </div>

            <div class="summon-item-section">
                <h4>Gegenstand beschwören</h4>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="system.preEffects.{{@index}}.summonItem.enabled" {{checked summonItem.enabled}} />
                        Aktiviert
                    </label>
                </div>
                <div class="form-group">
                    <label>Art:</label>
                    <select name="system.preEffects.{{@index}}.summonItem.sourceKind">
                        <option value="waffe" {{#unless (ifEq summonItem.sourceKind "gegenstand")}}selected{{/unless}}>Waffe</option>
                        <option value="gegenstand" {{#if (ifEq summonItem.sourceKind "gegenstand")}}selected{{/if}}>Gegenstand</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quelle:</label>
                    {{#if (ifEq summonItem.sourceKind "gegenstand")}}
                    <input type="text" name="system.preEffects.{{@index}}.summonItem.sourceUuid" value="{{summonItem.sourceUuid}}" list="ilaris-summon-item-sources-gegenstand" placeholder="Gegenstand suchen …" />
                    {{else}}
                    <input type="text" name="system.preEffects.{{@index}}.summonItem.sourceUuid" value="{{summonItem.sourceUuid}}" list="ilaris-summon-item-sources-waffe" placeholder="Waffe suchen …" />
                    {{/if}}
                </div>
                <div class="summon-item-overrides-list">
                    <h5>Werte auf der beschworenen Kopie</h5>
                    {{#each summonItem.overrides}}
                    <fieldset class="summon-item-override-card">
                        <legend>Überschreibung</legend>
                        <button type="button" class="delete-summon-item-override">✕</button>
                        <div class="form-group">
                            <label>Datenpfad:</label>
                            <input type="text" name="system.preEffects.{{@../index}}.summonItem.overrides.{{@index}}.path" value="{{path}}" placeholder="z. B. system.tp" />
                        </div>
                        <div class="form-group">
                            <label>Wert:</label>
                            <input type="text" name="system.preEffects.{{@../index}}.summonItem.overrides.{{@index}}.value" value="{{value}}" />
                        </div>
                        <div class="form-group">
                            <label><input type="checkbox" name="system.preEffects.{{@../index}}.summonItem.overrides.{{@index}}.amplifiedByMaechtigeMagie" {{checked amplifiedByMaechtigeMagie}} /> Verstärkt durch Mächtige Magie</label>
                        </div>
                        <div class="form-group">
                            <label>Mächtig-Bonus:</label>
                            <input type="text" name="system.preEffects.{{@../index}}.summonItem.overrides.{{@index}}.maechtigBonus" value="{{maechtigBonus}}" placeholder="z. B. +1W20" />
                        </div>
                    </fieldset>
                    {{/each}}
                    <button type="button" class="add-summon-item-override">+ Überschreibung hinzufügen</button>
                </div>
            </div>

            <div class="armed-combat-section">
                <h4>Bewaffneter Kampfeffekt</h4>
                <div class="form-group">
                    <label><input type="checkbox" name="system.preEffects.{{@index}}.armedCombat.enabled" {{checked armedCombat.enabled}} /> Aktiviert</label>
                </div>
                <div class="form-group">
                    <label>Auslösung:</label>
                    <select name="system.preEffects.{{@index}}.armedCombat.trigger">
                        <option value="nextSuccessfulAttack" {{#if (ifEq armedCombat.trigger "nextSuccessfulAttack")}}selected{{/if}}>Nächster erfolgreicher Angriff</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Angriffsart:</label>
                    <select name="system.preEffects.{{@index}}.armedCombat.scope">
                        <option value="any" {{#if (ifEq armedCombat.scope "any")}}selected{{/if}}>Beliebig</option>
                        <option value="melee" {{#if (ifEq armedCombat.scope "melee")}}selected{{/if}}>Nahkampf</option>
                        <option value="ranged" {{#if (ifEq armedCombat.scope "ranged")}}selected{{/if}}>Fernkampf</option>
                    </select>
                </div>
                <div class="form-group"><label>AT-Bonus:</label><input type="number" name="system.preEffects.{{@index}}.armedCombat.attackBonus" value="{{armedCombat.attackBonus}}" /></div>
                <div class="form-group"><label>Eingabeschlüssel:</label><input type="text" name="system.preEffects.{{@index}}.armedCombat.inputs.0.key" value="{{armedCombat.inputs.0.key}}" placeholder="z. B. previousHits" /></div>
                <div class="form-group"><label>Eingabelabel:</label><input type="text" name="system.preEffects.{{@index}}.armedCombat.inputs.0.label" value="{{armedCombat.inputs.0.label}}" /></div>
                <div class="form-group"><label>Standard:</label><input type="number" name="system.preEffects.{{@index}}.armedCombat.inputs.0.default" value="{{armedCombat.inputs.0.default}}" /></div>
                <div class="form-group"><label>Minimum:</label><input type="number" name="system.preEffects.{{@index}}.armedCombat.inputs.0.min" value="{{armedCombat.inputs.0.min}}" /></div>
                <div class="form-group"><label>Maximum:</label><input type="number" name="system.preEffects.{{@index}}.armedCombat.inputs.0.max" value="{{armedCombat.inputs.0.max}}" /></div>
                <div class="form-group"><label>Schaden-Eingabe:</label><input type="text" name="system.preEffects.{{@index}}.armedCombat.damage.input" value="{{armedCombat.damage.input}}" /></div>
                <div class="form-group"><label>Schaden je Einheit:</label><input type="text" name="system.preEffects.{{@index}}.armedCombat.damage.perInput" value="{{armedCombat.damage.perInput}}" placeholder="W6" /></div>
                <div class="form-group"><label>Ladungen:</label><input type="number" min="1" name="system.preEffects.{{@index}}.armedCombat.charges.base" value="{{armedCombat.charges.base}}" /></div>
                <div class="form-group"><label><input type="checkbox" name="system.preEffects.{{@index}}.armedCombat.charges.amplifiedByMaechtigeMagie" {{checked armedCombat.charges.amplifiedByMaechtigeMagie}} /> Verstärkt durch Mächtige Magie/Liturgie</label></div>
                <div class="form-group"><label>Ladungen je QS:</label><input type="number" min="0" name="system.preEffects.{{@index}}.armedCombat.charges.maechtigBonus" value="{{armedCombat.charges.maechtigBonus}}" /></div>
            </div>

            <div class="avoid-test-section">
                <h4>Widerstands-Probe</h4>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="system.preEffects.{{@index}}.avoidTest.enabled" {{checked avoidTest.enabled}} />
                        Aktiviert
                    </label>
                </div>
                <div class="avoid-test-fields">
                    <div class="form-group">
                        <label>Fertigkeit:</label>
                        <select name="system.preEffects.{{@index}}.avoidTest.fertigkeit">
                            <option value="">— Keine —</option>
                            {{#each @root.avoidTestSkillOptions}}
                            <optgroup label="{{packName}}">
                                {{#each skills}}
                                <option value="{{name}}" {{#if (ifEq name ../../avoidTest.fertigkeit)}}selected{{/if}}>{{name}} ({{type}})</option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                            {{#if avoidTest.fertigkeit}}
                            {{#unless (isSkillInOptions avoidTest.fertigkeit @root.avoidTestSkillOptions)}}
                            <option value="{{avoidTest.fertigkeit}}" selected>⚠ {{avoidTest.fertigkeit}} (nicht verfügbar)</option>
                            {{/unless}}
                            {{/if}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Talent (optional):</label>
                        <select name="system.preEffects.{{@index}}.avoidTest.talent">
                            <option value="">— Keines —</option>
                            {{#each @root.avoidTestTalentOptions}}
                            <optgroup label="{{packName}}">
                                {{#each talents}}
                                {{#if (ifEq fertigkeit ../../avoidTest.fertigkeit)}}
                                <option value="{{name}}" {{#if (ifEq name ../../avoidTest.talent)}}selected{{/if}}>{{name}}</option>
                                {{/if}}
                                {{/each}}
                            </optgroup>
                            {{/each}}
                            {{#if avoidTest.talent}}
                            {{#unless (isTalentInOptions avoidTest.talent avoidTest.fertigkeit @root.avoidTestTalentOptions)}}
                            <option value="{{avoidTest.talent}}" selected>⚠ {{avoidTest.talent}} (nicht verfügbar)</option>
                            {{/unless}}
                            {{/if}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Attribut:</label>
                        <select name="system.preEffects.{{@index}}.avoidTest.attribut">
                            <option value="">— Keines —</option>
                            {{#each @root.avoidTestAttributeOptions}}
                            <option value="{{value}}" {{#if (ifEq value ../../avoidTest.attribut)}}selected{{/if}}>{{label}}</option>
                            {{/each}}
                            {{#if avoidTest.attribut}}
                            {{#unless (isAttrInOptions avoidTest.attribut @root.avoidTestAttributeOptions)}}
                            <option value="{{avoidTest.attribut}}" selected>⚠ {{avoidTest.attribut}} (nicht verfügbar)</option>
                            {{/unless}}
                            {{/if}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="system.preEffects.{{@index}}.avoidTest.diminishedOnly" {{checked avoidTest.diminishedOnly}} />
                            Nur abgeschwächt (Diminished Only)
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Schwierigkeit aus:</label>
                        <select name="system.preEffects.{{@index}}.avoidTest.resistDifficultySource">
                            <option value="fixed" {{#unless (ifEq avoidTest.resistDifficultySource "triggeringRoll")}}selected{{/unless}}>Fester Wert</option>
                            <option value="triggeringRoll" {{#if (ifEq avoidTest.resistDifficultySource "triggeringRoll")}}selected{{/if}}>Ergebnis der auslösenden Probe</option>
                        </select>
                    </div>
                    {{#unless (ifEq avoidTest.resistDifficultySource "triggeringRoll")}}
                    <div class="form-group">
                        <label>Erschwernis:</label>
                        <input type="number" name="system.preEffects.{{@index}}.avoidTest.resistDifficulty" value="{{avoidTest.resistDifficulty}}" data-dtype="Number" placeholder="12" />
                    </div>
                    {{/unless}}
                </div>
            </div>
            </fieldset>
            {{/each}}
            <datalist id="ilaris-summon-item-sources-waffe">
                {{#each @root.summonItemOptions.waffe}}
                    {{#each items}}
                    <option value="{{uuid}}" label="{{name}} ({{type}}, {{../packName}})"></option>
                    {{/each}}
                {{/each}}
            </datalist>
            <datalist id="ilaris-summon-item-sources-gegenstand">
                {{#each @root.summonItemOptions.gegenstand}}
                    {{#each items}}
                    <option value="{{uuid}}" label="{{name}} ({{type}}, {{../packName}})"></option>
                    {{/each}}
                {{/each}}
            </datalist>
            <button type="button" class="add-pre-effect">+ Pre-Effect hinzufügen</button>
        {{#if @root.hasLLMPreEffectGeneration}}
        <button type="button" class="generate-pre-effect">🤖 Generieren</button>
        {{/if}}
    </div>
</section>
