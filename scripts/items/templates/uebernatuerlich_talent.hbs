{{log 'ue talent' this}}
<section class="{{cssClass}}">
    <div>
        <div>
            <header class="sheet-header">
                <div class="header-fields">
                    <h1 class="charname">
                        <input name="name" type="text" value="{{item.name}}" autofocus />
                    </h1>
                </div>
            </header>
        </div>

        {{#if hasOwner}}
        <label>Fertigkeit:</label>
        <select name="system.fertigkeit_ausgewaehlt">
            <option value="auto">auto</option>
            {{selectOptions fertigkeit_list selected=item.system.fertigkeit_ausgewaehlt}}
        </select>
        {{/if}}
        <div>
            <div class="flexrow">
                <label>Mächtig:</label>
                <textarea rows="10" name="system.maechtig">{{item.system.maechtig}}</textarea>
            </div>
            <div class="flexrow">
                <label>Schwierigkeit:</label>
                <input
                    name="system.schwierigkeit"
                    value="{{item.system.schwierigkeit}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Modifikationen:</label>
                <textarea name="system.modifikationen">{{item.system.modifikationen}}</textarea>
            </div>
            <section class="zone-profile-editor">
                <h3>Zonenautomatisierung</h3>
                <p class="hint">Optional. Ohne Form bleibt dieses Talent vollstaendig manuell.</p>
                <div class="form-group"><label>Form</label><select name="system.zone.shape"><option value="">Keine Zone</option><option value="cone" {{#if (ifEq item.system.zone.shape "cone")}}selected{{/if}}>Kegel</option><option value="circle" {{#if (ifEq item.system.zone.shape "circle")}}selected{{/if}}>Kreis</option><option value="rectangle" {{#if (ifEq item.system.zone.shape "rectangle")}}selected{{/if}}>Wand/Rechteck</option></select></div>
                <div class="form-group"><label>Laenge/Radius</label><input type="number" min="1" name="system.zone.distance" value="{{item.system.zone.distance}}" /></div>
                <div class="form-group"><label>Kegelwinkel</label><input type="number" min="1" name="system.zone.angle" value="{{item.system.zone.angle}}" /></div>
                <div class="form-group"><label>Wandbreite</label><input type="number" min="1" name="system.zone.width" value="{{item.system.zone.width}}" /></div>
                <div class="form-group"><label>Verankerung</label><select name="system.zone.placement.anchor"><option value="caster" {{#if (ifEq item.system.zone.placement.anchor "caster")}}selected{{/if}}>Beim Zaubernden</option><option value="free" {{#if (ifEq item.system.zone.placement.anchor "free")}}selected{{/if}}>Frei platzierbar</option></select><label>Reichweite</label><input type="number" min="0" name="system.zone.placement.range" value="{{item.system.zone.placement.range}}" /></div>
                <div class="form-group"><label>Lebenszyklus</label><select name="system.zone.lifecycle"><option value="instant" {{#if (ifEq item.system.zone.lifecycle "instant")}}selected{{/if}}>Sofortig</option><option value="persistent" {{#if (ifEq item.system.zone.lifecycle "persistent")}}selected{{/if}}>Bleibend</option></select></div>
                <div class="form-group"><label>Dauerquelle</label><select name="system.zone.duration.source"><option value="fixed" {{#unless (ifEq item.system.zone.duration.source "casterAttribute")}}selected{{/unless}}>Feste Szenenrunden</option><option value="casterAttribute" {{#if (ifEq item.system.zone.duration.source "casterAttribute")}}selected{{/if}}>Hauptattribut der zaubernden Person</option></select><label>Szenenrunden</label><input type="number" min="1" name="system.zone.duration.remaining" value="{{item.system.zone.duration.remaining}}" /><label>Hauptattribut</label><select name="system.zone.duration.attribute"><option value="">-- wählen --</option><option value="MU" {{#if (ifEq item.system.zone.duration.attribute "MU")}}selected{{/if}}>MU</option><option value="KL" {{#if (ifEq item.system.zone.duration.attribute "KL")}}selected{{/if}}>KL</option><option value="IN" {{#if (ifEq item.system.zone.duration.attribute "IN")}}selected{{/if}}>IN</option><option value="CH" {{#if (ifEq item.system.zone.duration.attribute "CH")}}selected{{/if}}>CH</option><option value="FF" {{#if (ifEq item.system.zone.duration.attribute "FF")}}selected{{/if}}>FF</option><option value="GE" {{#if (ifEq item.system.zone.duration.attribute "GE")}}selected{{/if}}>GE</option><option value="KO" {{#if (ifEq item.system.zone.duration.attribute "KO")}}selected{{/if}}>KO</option><option value="KK" {{#if (ifEq item.system.zone.duration.attribute "KK")}}selected{{/if}}>KK</option></select></div>
                <label><input type="checkbox" name="system.zone.trigger.triggerOnCreate" {{checked item.system.zone.trigger.triggerOnCreate}} /> Beim Erzeugen ausloesen</label>
                <label><input type="checkbox" name="system.zone.trigger.onEnter" {{checked item.system.zone.trigger.onEnter}} /> Beim Betreten ausloesen</label>
                <label><input type="checkbox" name="system.zone.trigger.onRoundStart" {{checked item.system.zone.trigger.onRoundStart}} /> Zu Rundenbeginn ausloesen</label>
                <div class="form-group zone-movement-resistance"><label><input type="checkbox" name="system.zone.movementResistance.enabled" {{checked item.system.zone.movementResistance.enabled}} /> Bewegungswiderstand</label><label>Attribut</label><select name="system.zone.movementResistance.attribut"><option value="">-- wählen --</option><option value="MU" {{#if (ifEq item.system.zone.movementResistance.attribut "MU")}}selected{{/if}}>MU</option><option value="KL" {{#if (ifEq item.system.zone.movementResistance.attribut "KL")}}selected{{/if}}>KL</option><option value="IN" {{#if (ifEq item.system.zone.movementResistance.attribut "IN")}}selected{{/if}}>IN</option><option value="CH" {{#if (ifEq item.system.zone.movementResistance.attribut "CH")}}selected{{/if}}>CH</option><option value="FF" {{#if (ifEq item.system.zone.movementResistance.attribut "FF")}}selected{{/if}}>FF</option><option value="GE" {{#if (ifEq item.system.zone.movementResistance.attribut "GE")}}selected{{/if}}>GE</option><option value="KO" {{#if (ifEq item.system.zone.movementResistance.attribut "KO")}}selected{{/if}}>KO</option><option value="KK" {{#if (ifEq item.system.zone.movementResistance.attribut "KK")}}selected{{/if}}>KK</option></select><label>Schwierigkeit</label><input type="number" name="system.zone.movementResistance.resistDifficulty" value="{{item.system.zone.movementResistance.resistDifficulty}}" /></div>
                <button type="button" class="clear-zone-profile">Zonenprofil entfernen</button>
            </section>
            <section class="spell-modification-editor">
                <h3>Strukturierte Zaubermodifikationen</h3>
                <p class="hint">Diese Formen ersetzen nur die automatisch erzeugten Modifikationsmanöver. Der Regeltext oben bleibt erhalten.</p>
                <button type="button" class="add-spell-modification-group">Gruppe hinzufügen</button>
                {{#each item.system.spellModificationGroups as |group|}}
                <fieldset class="spell-modification-group-card">
                    <legend>Gruppe {{@index}}</legend>
                    <div class="form-group"><label>ID</label><input type="text" name="system.spellModificationGroups.{{@index}}.id" value="{{group.id}}" /></div>
                    <div class="form-group"><label>Bezeichnung</label><input type="text" name="system.spellModificationGroups.{{@index}}.label" value="{{group.label}}" /></div>
                    <label><input type="checkbox" name="system.spellModificationGroups.{{@index}}.required" {{checked group.required}} /> Genau eine Auswahl erforderlich</label>
                    <button type="button" class="delete-spell-modification-group" data-group-index="{{@index}}">Gruppe löschen</button>
                </fieldset>
                {{/each}}
                <button type="button" class="add-spell-modification">Zaubermodifikation hinzufügen</button>
                {{#each item.system.spellModifications as |form|}}
                <fieldset class="spell-modification-card">
                    <legend>Form {{@index}}: {{form.name}}</legend>
                    <div class="form-group"><label>ID</label><input type="text" name="system.spellModifications.{{@index}}.id" value="{{form.id}}" /></div>
                    <div class="form-group"><label>Name</label><input type="text" name="system.spellModifications.{{@index}}.name" value="{{form.name}}" /></div>
                    <div class="form-group"><label>Beschreibung</label><textarea name="system.spellModifications.{{@index}}.description">{{form.description}}</textarea></div>
                    <div class="form-group"><label>Gruppe</label><input type="text" name="system.spellModifications.{{@index}}.group" value="{{form.group}}" list="spell-modification-groups" /></div>
                    <div class="form-group"><label>Effektmodus</label><select name="system.spellModifications.{{@index}}.effectMode"><option value="inherit" {{#if (ifEq form.effectMode "inherit")}}selected{{/if}}>Basis übernehmen</option><option value="extend" {{#if (ifEq form.effectMode "extend")}}selected{{/if}}>Basis erweitern</option><option value="replace" {{#if (ifEq form.effectMode "replace")}}selected{{/if}}>Basis ersetzen</option></select></div>
                    <h4>Profil</h4>
                    <div class="form-group"><label>Schwierigkeit</label><input type="number" name="system.spellModifications.{{@index}}.profile.difficulty" value="{{form.profile.difficulty}}" /></div>
                    <div class="form-group"><label>Kostenmodus</label><select name="system.spellModifications.{{@index}}.profile.cost.mode"><option value="add" {{#if (ifEq form.profile.cost.mode "add")}}selected{{/if}}>Addieren</option><option value="set" {{#if (ifEq form.profile.cost.mode "set")}}selected{{/if}}>Setzen</option></select><input type="number" name="system.spellModifications.{{@index}}.profile.cost.value" value="{{form.profile.cost.value}}" /></div>
                    <div class="form-group"><label>Permanente Kosten</label><input type="text" name="system.spellModifications.{{@index}}.profile.permanentCost" value="{{form.profile.permanentCost}}" /></div>
                    <div class="form-group"><label>Ziel</label><input type="text" name="system.spellModifications.{{@index}}.profile.target" value="{{form.profile.target}}" /></div>
                    <div class="form-group"><label>Reichweite</label><input type="text" name="system.spellModifications.{{@index}}.profile.range" value="{{form.profile.range}}" /></div>
                    <div class="form-group"><label>Wirkungsdauer</label><input type="text" name="system.spellModifications.{{@index}}.profile.duration" value="{{form.profile.duration}}" /></div>
                    <h4>Zonenform</h4>
                    <p class="hint">Leer laesst das Basisprofil unveraendert. Eine deaktivierte Zone schaltet ein geerbtes Basisprofil aus.</p>
                    <div class="form-group"><label>Form</label><select name="system.spellModifications.{{@index}}.zone.shape"><option value="">Keine Ueberschreibung</option><option value="cone" {{#if (ifEq form.zone.shape "cone")}}selected{{/if}}>Kegel</option><option value="circle" {{#if (ifEq form.zone.shape "circle")}}selected{{/if}}>Kreis</option><option value="rectangle" {{#if (ifEq form.zone.shape "rectangle")}}selected{{/if}}>Wand/Rechteck</option></select></div>
                    <div class="form-group"><label>Laenge/Radius</label><input type="number" min="1" name="system.spellModifications.{{@index}}.zone.distance" value="{{form.zone.distance}}" /></div>
                    <div class="form-group"><label>Kegelwinkel</label><input type="number" min="1" name="system.spellModifications.{{@index}}.zone.angle" value="{{form.zone.angle}}" /></div>
                    <div class="form-group"><label>Wandbreite</label><input type="number" min="1" name="system.spellModifications.{{@index}}.zone.width" value="{{form.zone.width}}" /></div>
                    <div class="form-group"><label>Verankerung</label><select name="system.spellModifications.{{@index}}.zone.placement.anchor"><option value="">Basis uebernehmen</option><option value="caster" {{#if (ifEq form.zone.placement.anchor "caster")}}selected{{/if}}>Beim Zaubernden</option><option value="free" {{#if (ifEq form.zone.placement.anchor "free")}}selected{{/if}}>Frei platzierbar</option></select><label>Reichweite</label><input type="number" min="0" name="system.spellModifications.{{@index}}.zone.placement.range" value="{{form.zone.placement.range}}" /></div>
                    <div class="form-group"><label>Lebenszyklus</label><select name="system.spellModifications.{{@index}}.zone.lifecycle"><option value="">Basis uebernehmen</option><option value="instant" {{#if (ifEq form.zone.lifecycle "instant")}}selected{{/if}}>Sofortig</option><option value="persistent" {{#if (ifEq form.zone.lifecycle "persistent")}}selected{{/if}}>Bleibend</option></select></div>
                    <div class="form-group"><label>Dauerquelle</label><select name="system.spellModifications.{{@index}}.zone.duration.source"><option value="">Basis uebernehmen</option><option value="fixed" {{#if (ifEq form.zone.duration.source "fixed")}}selected{{/if}}>Feste Szenenrunden</option><option value="casterAttribute" {{#if (ifEq form.zone.duration.source "casterAttribute")}}selected{{/if}}>Hauptattribut der zaubernden Person</option></select><label>Szenenrunden</label><input type="number" min="1" name="system.spellModifications.{{@index}}.zone.duration.remaining" value="{{form.zone.duration.remaining}}" /><label>Hauptattribut</label><select name="system.spellModifications.{{@index}}.zone.duration.attribute"><option value="">Basis uebernehmen</option><option value="MU" {{#if (ifEq form.zone.duration.attribute "MU")}}selected{{/if}}>MU</option><option value="KL" {{#if (ifEq form.zone.duration.attribute "KL")}}selected{{/if}}>KL</option><option value="IN" {{#if (ifEq form.zone.duration.attribute "IN")}}selected{{/if}}>IN</option><option value="CH" {{#if (ifEq form.zone.duration.attribute "CH")}}selected{{/if}}>CH</option><option value="FF" {{#if (ifEq form.zone.duration.attribute "FF")}}selected{{/if}}>FF</option><option value="GE" {{#if (ifEq form.zone.duration.attribute "GE")}}selected{{/if}}>GE</option><option value="KO" {{#if (ifEq form.zone.duration.attribute "KO")}}selected{{/if}}>KO</option><option value="KK" {{#if (ifEq form.zone.duration.attribute "KK")}}selected{{/if}}>KK</option></select></div>
                    <label><input type="checkbox" name="system.spellModifications.{{@index}}.zone.trigger.triggerOnCreate" {{checked form.zone.trigger.triggerOnCreate}} /> Beim Erzeugen ausloesen</label>
                    <label><input type="checkbox" name="system.spellModifications.{{@index}}.zone.trigger.onEnter" {{checked form.zone.trigger.onEnter}} /> Beim Betreten ausloesen</label>
                    <label><input type="checkbox" name="system.spellModifications.{{@index}}.zone.trigger.onRoundStart" {{checked form.zone.trigger.onRoundStart}} /> Zu Rundenbeginn ausloesen</label>
                    <div class="form-group zone-movement-resistance"><label><input type="checkbox" name="system.spellModifications.{{@index}}.zone.movementResistance.enabled" {{checked form.zone.movementResistance.enabled}} /> Bewegungswiderstand</label><label>Attribut</label><select name="system.spellModifications.{{@index}}.zone.movementResistance.attribut"><option value="">Basis uebernehmen</option><option value="MU" {{#if (ifEq form.zone.movementResistance.attribut "MU")}}selected{{/if}}>MU</option><option value="KL" {{#if (ifEq form.zone.movementResistance.attribut "KL")}}selected{{/if}}>KL</option><option value="IN" {{#if (ifEq form.zone.movementResistance.attribut "IN")}}selected{{/if}}>IN</option><option value="CH" {{#if (ifEq form.zone.movementResistance.attribut "CH")}}selected{{/if}}>CH</option><option value="FF" {{#if (ifEq form.zone.movementResistance.attribut "FF")}}selected{{/if}}>FF</option><option value="GE" {{#if (ifEq form.zone.movementResistance.attribut "GE")}}selected{{/if}}>GE</option><option value="KO" {{#if (ifEq form.zone.movementResistance.attribut "KO")}}selected{{/if}}>KO</option><option value="KK" {{#if (ifEq form.zone.movementResistance.attribut "KK")}}selected{{/if}}>KK</option></select><label>Schwierigkeit</label><input type="number" name="system.spellModifications.{{@index}}.zone.movementResistance.resistDifficulty" value="{{form.zone.movementResistance.resistDifficulty}}" /></div>
                    <button type="button" class="disable-spell-modification-zone" data-form-index="{{@index}}">Zone deaktivieren</button>
                    <button type="button" class="clear-spell-modification-zone" data-form-index="{{@index}}">Zonenueberschreibung loeschen</button>
                    <h4>Form-Pre-Effects</h4>
                    <button type="button" class="add-spell-modification-pre-effect" data-form-index="{{@index}}">Pre-Effect hinzufügen</button>
                    {{#each form.preEffects as |preEffect|}}
                    <div class="spell-modification-pre-effect-card">
                        <div class="form-group"><label>Dauer</label><input type="number" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.baseDuration" value="{{preEffect.baseDuration}}" /></div>
                        <label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.instant" {{checked preEffect.instant}} /> Sofortig</label>
                        <label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.summonItem.enabled" {{checked preEffect.summonItem.enabled}} /> Gegenstand beschwören</label>
                        <div class="form-group"><label>Quell-UUID</label><input type="text" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.summonItem.sourceUuid" value="{{preEffect.summonItem.sourceUuid}}" /></div>
                        <div class="form-group"><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.condition.enabled" {{checked preEffect.condition.enabled}} /> Zustand anwenden</label><select name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.condition.statusId"><option value="">-- Zustand wählen --</option>{{#each @root.statusEffectOptions}}<option value="{{id}}" {{#if (ifEq id ../condition.statusId)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
                        <fieldset class="form-pre-effect-resistance"><legend>Widerstandsprobe</legend><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.avoidTest.enabled" {{checked preEffect.avoidTest.enabled}} /> Widerstandsprobe aktiv</label><div class="form-group"><label>Attribut</label><select name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.avoidTest.attribut"><option value="">-- wählen --</option><option value="MU" {{#if (ifEq preEffect.avoidTest.attribut "MU")}}selected{{/if}}>MU</option><option value="KL" {{#if (ifEq preEffect.avoidTest.attribut "KL")}}selected{{/if}}>KL</option><option value="IN" {{#if (ifEq preEffect.avoidTest.attribut "IN")}}selected{{/if}}>IN</option><option value="CH" {{#if (ifEq preEffect.avoidTest.attribut "CH")}}selected{{/if}}>CH</option><option value="FF" {{#if (ifEq preEffect.avoidTest.attribut "FF")}}selected{{/if}}>FF</option><option value="GE" {{#if (ifEq preEffect.avoidTest.attribut "GE")}}selected{{/if}}>GE</option><option value="KO" {{#if (ifEq preEffect.avoidTest.attribut "KO")}}selected{{/if}}>KO</option><option value="KK" {{#if (ifEq preEffect.avoidTest.attribut "KK")}}selected{{/if}}>KK</option></select><label>Erschwernis</label><input type="number" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.avoidTest.resistDifficulty" value="{{preEffect.avoidTest.resistDifficulty}}" /></div></fieldset>
                        <fieldset class="form-pre-effect-failure"><legend>Bei misslungener Widerstandsprobe</legend><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.enabled" {{checked preEffect.resistanceOutcomes.failure.enabled}} /> Eigene Wirkung verwenden</label>{{#if preEffect.resistanceOutcomes.failure.enabled}}<div class="form-group"><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.marker.enabled" {{checked preEffect.resistanceOutcomes.failure.marker.enabled}} /> Hinweis-Effekt</label></div><div class="form-group"><label>Marker-ID</label><input type="text" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.marker.id" value="{{preEffect.resistanceOutcomes.failure.marker.id}}" /><label>Marker-Anzeige</label><input type="text" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.marker.label" value="{{preEffect.resistanceOutcomes.failure.marker.label}}" /></div><div class="form-group"><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.condition.enabled" {{checked preEffect.resistanceOutcomes.failure.condition.enabled}} /> Zustand anwenden</label><select name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.condition.statusId"><option value="">-- Zustand wählen --</option>{{#each @root.statusEffectOptions}}<option value="{{id}}" {{#if (ifEq id ../resistanceOutcomes.failure.condition.statusId)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div><div class="form-group"><label><input type="checkbox" name="system.spellModifications.{{@../index}}.preEffects.{{@index}}.resistanceOutcomes.failure.tableManagedDisplacement.enabled" {{checked preEffect.resistanceOutcomes.failure.tableManagedDisplacement.enabled}} /> Zurückstoßen (Spielleitung)</label><p class="hint">Wendet die konfigurierte Wirkung an und informiert Zielbesitzende sowie Spielleitungen, dass die Token-Position manuell angepasst wird.</p></div>{{/if}}</fieldset>
                        <button type="button" class="delete-spell-modification-pre-effect" data-form-index="{{@../index}}" data-pre-effect-index="{{@index}}">Pre-Effect löschen</button>
                    </div>
                    {{/each}}
                    <button type="button" class="move-spell-modification" data-form-index="{{@index}}" data-direction="-1">↑</button>
                    <button type="button" class="move-spell-modification" data-form-index="{{@index}}" data-direction="1">↓</button>
                    <button type="button" class="delete-spell-modification" data-form-index="{{@index}}">Form löschen</button>
                </fieldset>
                {{/each}}
                <datalist id="spell-modification-groups">{{#each item.system.spellModificationGroups}}<option value="{{id}}">{{label}}</option>{{/each}}</datalist>
            </section>
            <div class="flexrow">
                <label>Vorbereitung:</label>
                <input
                    name="system.vorbereitung"
                    value="{{item.system.vorbereitung}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Ziel:</label>
                <input
                    name="system.ziel"
                    value="{{item.system.ziel}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Reichweite:</label>
                <input
                    name="system.reichweite"
                    value="{{item.system.reichweite}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Wirkungsdauer:</label>
                <input
                    name="system.wirkungsdauer"
                    value="{{item.system.wirkungsdauer}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Kosten:</label>
                <input
                    name="system.kosten"
                    value="{{item.system.kosten}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Fertigkeiten:</label>
                <input
                    name="system.fertigkeiten"
                    value="{{item.system.fertigkeiten}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <div class="flexrow">
                <label>Erlernen:</label>
                <input
                    name="system.erlernen"
                    value="{{item.system.erlernen}}"
                    type="text"
                    data-dtype="String"
                />
            </div>
            <label>Beschreibung:</label>
            <textarea name="system.text">{{item.system.text}}</textarea>
        </div>
    </div>
    <div>
        <label>Löschen</label>
        <a data-action="deleteItem" data-itemclass="freieFertigkeit" data-itemid="{{item._id}}">
            <i class="fas fa-trash"></i>
        </a>
    </div>
</section>
