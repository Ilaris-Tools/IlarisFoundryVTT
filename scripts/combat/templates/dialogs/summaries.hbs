<div>
    {{#if zonePlacementEnabled}}
        <div class="zone-placement-control">
            <button type="button" data-action="placeZone">
                <i class="fas fa-draw-polygon"></i>
                Zone platzieren
            </button>
            {{#if zonePlacementReady}}
                <span class="zone-placement-ready"><i class="fas fa-check"></i> Zone platziert</span>
            {{/if}}
        </div>
    {{/if}}
    <div class="flex_center_center">
        <div>{{summary.title}}</div>
    </div>
    <div id="modifier-summary" class="modifier-summary-container">
        <div class="all-summaries">
            {{#if summary.isError}}
                <div class="modifier-summary">
                    <div class="modifier-item neutral">{{summary.message}}</div>
                </div>
            {{else if summary.isEmpty}}
                <div class="modifier-summary">
                    <div class="modifier-item neutral">{{summary.message}}</div>
                </div>
            {{else}}
                {{#each summary.sections as |section|}}
                    <div class="{{section.cssClass}}" {{#if section.action}}data-action="{{section.action}}"{{/if}}>
                        <div class="flex_space-between_center">
                            <h4 class="{{section.headingClass}}" style="width:100%">{{section.heading}}</h4>
                            <i class="custom-icon-without-hover"></i>
                        </div>
                        <div class="modifier-list">
                            {{#each section.rows as |row|}}
                                <div class="{{row.cssClass}}">
                                    {{row.label}}: <span>{{row.value}}</span>
                                </div>
                            {{/each}}

                            {{#each section.sections as |subsection|}}
                                {{#if subsection.title}}
                                    <div class="modifier-section">{{subsection.title}}</div>
                                {{/if}}
                                {{#each subsection.items as |item|}}
                                    <div class="{{item.cssClass}}">{{item.text}}</div>
                                {{/each}}
                            {{/each}}

                            {{#if section.showDivider}}
                                <hr>
                            {{/if}}

                            {{#each section.footerRows as |row|}}
                                <div class="{{row.cssClass}}">
                                    {{#if row.label}}
                                        {{row.label}}: <span>{{row.value}}</span>
                                    {{else if row.strong}}
                                        <strong>{{row.text}}</strong>
                                    {{else}}
                                        {{row.text}}
                                    {{/if}}
                                </div>
                            {{/each}}

                            {{#if section.actionButtons.length}}
                                <hr>
                                <div class="modifier-section">Energie abrechnen:</div>
                                {{#each section.actionButtons as |button|}}
                                    <div class="{{button.cssClass}}" {{#if button.action}}data-action="{{button.action}}"{{/if}} style="{{button.style}}">
                                        {{button.text}}
                                    </div>
                                {{/each}}
                            {{/if}}

                            {{#if section.totalRow}}
                                <div class="{{section.totalRow.cssClass}}">
                                    <strong>{{section.totalRow.text}}</strong>
                                </div>
                            {{/if}}

                            {{#if section.suppression}}
                                <details class="ilaris-suppression-ledger">
                                    <summary aria-label="{{section.suppression.label}}" title="{{section.suppression.label}}"><i class="fas fa-eye-slash"></i></summary>
                                    {{#each section.suppression.entries as |entry|}}
                                        <div class="modifier-item neutral">{{entry.sourceName}}: {{entry.value}} – {{entry.reason}}</div>
                                    {{/each}}
                                </details>
                            {{/if}}
                        </div>
                    </div>
                {{/each}}
            {{/if}}
        </div>
    </div>
</div>
