{{log 'effekte' this}}
<section class="tab effekte {{tab.cssClass}}" data-group="primary" data-tab="effekte">
    <h2>Effekte</h2>
    <div>
        <a data-action="itemCreate" data-itemclass="effect"><i class="fas fa-plus"></i> Neuer Effekt</a>
    </div>
    {{#each effects as |effect|}}
    <a data-action="itemEdit" data-itemclass="effect" data-itemid="{{effect._id}}">
                {{effect.name}}
                {{#if effect.effectDurationLabel}}| {{effect.effectDurationLabel}}{{/if}}
                {{#if effect.armedChargesLabel}}| {{effect.armedChargesLabel}}{{/if}}
                {{#if effect.conditionSourcesLabel}}| {{effect.conditionSourcesLabel}}{{/if}}
    </a>
    {{#unless (eq effect.flags.ilaris.sourceType "vorteil")}}
    <a data-action="itemDelete" data-itemclass="effect" data-itemid="{{effect._id}}">
        <i class="fas fa-trash"></i>
    </a>
    {{/unless}}
    {{#if (eq effect.system.ilarisEnding.type "opposedEscape")}}
    <a data-action="escapeEffect" data-itemid="{{effect._id}}"><i class="fas fa-unlink"></i> Befreiungsprobe</a>
    {{/if}}
    &nbsp; | &nbsp; {{/each}}
</section>
