<section class="tab general {{tab.cssClass}}" data-group="primary" data-tab="GENERAL">
    {{#if isGM}}
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Platzbedarf berücksichtigen</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Platzbedarf ist eine Hausregel aus Ilaris Advanced. Ohne Haken wird der Platzbedarf nicht angezeigt und in Berechnungen als 0 angenommen.</p>
            </div>
            <input type="checkbox" name="general.weaponSpaceRequirement" {{#if settings.weaponSpaceRequirement}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Echte Patzer und Krits</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Eine 1 ist immer ein Patzer und eine 20 immer ein Krit, unabhängig vom Probenergebnis.</p>
            </div>
            <input type="checkbox" name="general.realFumbleCrits" {{#if settings.realFumbleCrits}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Umbenennen von Triumph in Crit</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Für alle, die lieber das Wort "Crit" anstelle von "Triumph" verwenden.</p>
            </div>
            <input type="checkbox" name="general.renameTriumphWithCrit" {{#if settings.renameTriumphWithCrit}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Energiekosten-Einstellung einschränken</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Wenn aktiviert, können Energiekosten nur bei Unitatio-Vorteil oder nicht-numerischen Kosten gesetzt werden.</p>
            </div>
            <input type="checkbox" name="general.restrictEnergyCostSetting" {{#if settings.restrictEnergyCostSetting}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Hexagonale Token-Bilder</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Wenn aktiviert, werden Charakterbilder auf Hexfeld-Karten als Hexagone zugeschnitten.</p>
            </div>
            <input type="checkbox" name="general.hexTokenShapes" {{#if settings.hexTokenShapes}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Alternativ Fernkampf-Ausweichen Talent</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Das Alternativ-Talent zum Ausweichen von Fernkampfangriffen. Per Default wird Akrobatik verwendet.</p>
            </div>
            <select name="general.defaultRangedDodgeTalent" style="width: 50%;">
                {{selectOptions defaultRangedDodgeOptions selected=settings.defaultRangedDodgeTalent localize=false}}
            </select>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">LEP-System verwenden</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Ersetzt das Wundensystem durch ein direktes Lebenspunkte (LEP) System.</p>
            </div>
            <input type="checkbox" name="general.lepSystem" {{#if settings.lepSystem}}checked{{/if}}>
        </div>
        <div class="setting-row">
            <div class="setting-label-block">
                <span class="setting-label">Übernatürliche Effekte stapeln</span>
                <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
                <p class="setting-hint">Ilaris behält alle Effekte und wählt den stärksten positiven und den stärksten negativen übernatürlichen Effekt getrennt. Foundry addiert unterschiedliche Ilaris-Modifikatoren, ersetzt beim erneuten Wirken aber alle Active Effects derselben übernatürlichen Quelle.</p>
            </div>
            <select name="general.supernaturalEffectStacking">
                <option value="ilaris" {{#if (ifEq settings.supernaturalEffectStacking "ilaris")}}selected{{/if}}>Ilaris</option>
                <option value="foundry" {{#if (ifEq settings.supernaturalEffectStacking "foundry")}}selected{{/if}}>Foundry</option>
            </select>
        </div>
    {{/if}}

    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">Charakter-Synchronisation Button ausblenden</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal</span>
            <p class="setting-hint">Wenn aktiviert, wird der Button "Charakter mit Kompendium-Vorteilen Synchronisieren" auf dem Heldensheet ausgeblendet.</p>
        </div>
        <input type="checkbox" name="general.hideSyncKampfstileButton" {{#if settings.hideSyncKampfstileButton}}checked{{/if}}>
    </div>
    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">Heldensheet Reiter Rotation mit Tab</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal</span>
            <p class="setting-hint">Wenn aktiviert, kann auf dem Heldensheet mit Tab zwischen den Reitern rotiert werden.</p>
        </div>
        <input type="checkbox" name="general.enableTabbingCharacterSheet" {{#if settings.enableTabbingCharacterSheet}}checked{{/if}}>
    </div>
    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">Würfel details im Chat direkt anzeigen</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal</span>
            <p class="setting-hint">Zeigt Details zum Würfelwurf im Chat direkt an.</p>
        </div>
        <input type="checkbox" name="general.showDiceRollInChat" {{#if settings.showDiceRollInChat}}checked{{/if}}>
    </div>

    {{#if isGM}}
    <hr />
    <div class="setting-row setting-row-list damage-types">
        <div class="setting-label-block">
            <span class="setting-label">Schadenstypen</span>
            <span class="setting-scope"><i class="fas fa-globe"></i> Welt</span>
            <p class="setting-hint">Definiert die verfügbaren Schadenstypen für Pre-Effects und zukünftige Systemfunktionen. Jeder Typ hat einen Wert (Key), einen Anzeigenamen (Label) und ein Verhalten.</p>
        </div>
        <div class="damage-type-list" data-section="damageTypes">
            {{#each damageTypes}}
            <div class="damage-type-row flexrow">
                <span class="damage-type-label">{{label}}</span>
                <span class="damage-type-key">{{value}}</span>
                <span class="damage-type-behavior">
                    {{#if behavior.healing}}Heilung{{else}}Schaden{{/if}}
                    ·
                    {{#if behavior.targetsErschoepfung}}Erschöpfung{{else}}Wunden{{/if}}
                    {{#if behavior.bypassesArmor}} · Rüstung ignorieren{{/if}}
                </span>
                <button type="button" class="edit-damage-type" data-index="{{@index}}" title="Bearbeiten">✎</button>
                <button type="button" class="delete-damage-type" data-index="{{@index}}" title="Entfernen">✕</button>
            </div>
            {{/each}}
            <button type="button" class="add-damage-type">+ Typ hinzufügen</button>
        </div>
    </div>

    <hr />
    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">LLM API URL</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal (GM Browser)</span>
            <p class="setting-hint">Die URL des OpenAI-kompatiblen Chat-Completions-Endpunkts. Unterstützt: OpenAI, OpenRouter, DeepSeek, Ollama und andere.</p>
        </div>
        <input type="text" name="general.llmApiUrl" value="{{settings.llmApiUrl}}" placeholder="https://api.openai.com/v1/chat/completions" style="width: 60%;" />
    </div>
    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">LLM API Key</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal (GM Browser)</span>
            <p class="setting-hint">Der API-Schlüssel für den LLM-Dienst. Wird nur im Browser gespeichert und nie mit der Welt synchronisiert.</p>
        </div>
        <input type="password" name="general.llmApiKey" value="{{settings.llmApiKey}}" placeholder="sk-..." style="width: 60%;" />
    </div>
    <div class="setting-row">
        <div class="setting-label-block">
            <span class="setting-label">LLM Model</span>
            <span class="setting-scope"><i class="fas fa-user"></i> Lokal (GM Browser)</span>
            <p class="setting-hint">Das zu verwendende Modell. Beispiele: gpt-4o, deepseek-chat, openai/gpt-4o (OpenRouter), llama3 (Ollama).</p>
        </div>
        <input type="text" name="general.llmModel" value="{{settings.llmModel}}" placeholder="gpt-4o" style="width: 60%;" />
    </div>
    {{/if}}
</section>
