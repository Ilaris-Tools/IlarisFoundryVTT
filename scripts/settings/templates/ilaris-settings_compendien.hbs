<section class="tab compendien {{tab.cssClass}}" data-group="primary" data-tab="USED_COMPENDIEN">
    {{#if isGM}}
        {{#each compendienPacks}}
            <div class="setting-group">
                {{#if (eq @key "fertigkeiten")}}
                    <h3 class="setting-group-header">Fertigkeiten Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Fertigkeiten und übernatürliche Fertigkeiten enthalten.</p>
                {{else if (eq @key "waffen")}}
                    <h3 class="setting-group-header">Waffen Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Nah- und Fernkampfwaffen enthalten.</p>
                {{else if (eq @key "talente")}}
                    <h3 class="setting-group-header">Talente Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Talente, Liturgien und Zauber enthalten.</p>
                {{else if (eq @key "manoever")}}
                    <h3 class="setting-group-header">Manöver Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Manöver enthalten.</p>
                {{else if (eq @key "vorteile")}}
                    <h3 class="setting-group-header">Vorteile Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Vorteile enthalten.</p>
                {{else if (eq @key "waffeneigenschaften")}}
                    <h3 class="setting-group-header">Waffeneigenschaften Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die Waffeneigenschaften enthalten.</p>
                {{else if (eq @key "abgeleiteteWerte")}}
                    <h3 class="setting-group-header">Abgeleitete Werte Kompendien</h3>
                    <p class="setting-group-hint">Kompendien, die abgeleitete Werte enthalten. Wenn keine ausgewählt sind, werden die Standard-Berechnungen verwendet.</p>
                {{/if}}
                <div class="setting-group-content">
                {{#each this}}
                    <div class="form-group pack-entry {{#if this.isSystemPack}}system-pack{{/if}}">
                        <label class="checkbox">
                            <input type="checkbox" name="compendien.{{@../key}}.{{this.id}}" {{#if this.selected}}checked{{/if}}>
                            {{this.name}}
                        </label>
                    </div>
                {{/each}}
                </div>
            </div>
        {{/each}}
    {{else}}
        <p class="ilaris-gm-only-hint">
            <i class="fas fa-lock"></i>
            Diese Einstellungen können nur vom Spielleiter geändert werden.
        </p>
    {{/if}}
</section>

