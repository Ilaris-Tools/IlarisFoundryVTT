# Copy this file to e2e/.env. Start your licensed Foundry VTT instance yourself
# with the dedicated Ilaris E2E baseline world before running Playwright.
E2E_FOUNDRY_URL=http://127.0.0.1:30000

# Optional overrides. The E2E baseline defaults are e2e-gm and e2e-player.
# Leave passwords empty when the baseline users have no password.
E2E_FOUNDRY_USER=e2e-gm
E2E_PLAYER_USER=e2e-player
E2E_FOUNDRY_PASSWORD=
E2E_PLAYER_PASSWORD=
# E2E_CI_HEADLESS=true
# PLAYWRIGHT_CHROMIUM_CHANNEL=msedge
